{
    "openapi": "3.0.0",
    "x-origin": [
        {
            "url": "http://localhost:8000/openapi",
            "format": "swagger",
            "version": "2.0",
            "converter": {
                "url": "https://github.com/mermade/oas-kit",
                "version": "7.0.8"
            }
        }
    ],
    "info": {
        "title": "My Listings API",
        "description": "My Listings API",
        "version": "v1"
    },
    "security": [
        {
            "Basic": []
        }
    ],
    "paths": {
        "/accounts/login/": {
            "get": {
                "operationId": "redirect_to_login",
                "description": "Redirect to the login page. This endpoint is only used for the Swagger\nUI.",
                "responses": {
                    "200": {
                        "description": ""
                    },
                    "302": {
                        "description": "Redirect to the login page",
                        "type": "string"
                    }
                },
                "tags": [
                    "accounts"
                ]
            },
            "parameters": []
        },
        "/listings/": {
            "post": {
                "operationId": "listings_create",
                "summary": "Create a new listing",
                "description": ":param request: The request object\n:param args: The arguments\n:param kwargs: The keyword arguments\n:return: The response object",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "description": "Authorization",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "mock-session-user-id",
                        "in": "header",
                        "description": "Mock Session User Id",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateListing"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Listing"
                                }
                            }
                        }
                    }
                },
                "tags": [
                    "listings"
                ]
            },
            "parameters": []
        },
        "/listings/my-listings": {
            "get": {
                "operationId": "my_listings",
                "description": "View for the my listings endpoint",
                "parameters": [
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0
                        }
                    },
                    {
                        "name": "page_size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 25
                        }
                    },
                    {
                        "name": "Authorization",
                        "in": "header",
                        "description": "Authorization",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "mock-session-user-id",
                        "in": "header",
                        "description": "Mock Session User Id",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ListingsListResponse"
                                }
                            }
                        }
                    }
                },
                "tags": [
                    "listings"
                ]
            },
            "parameters": []
        },
        "/users/": {
            "get": {
                "operationId": "users_list",
                "description": "List users.\n:param request: The request object\n:return: The response object",
                "parameters": [
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0
                        }
                    },
                    {
                        "name": "page_size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 25
                        }
                    },
                    {
                        "name": "email",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "Authorization",
                        "in": "header",
                        "description": "Authorization",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "mock-session-user-id",
                        "in": "header",
                        "description": "Mock Session User Id",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List users",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ListUsersResponse"
                                }
                            }
                        }
                    }
                },
                "tags": [
                    "users"
                ]
            },
            "parameters": []
        },
        "/users/login-callback": {
            "get": {
                "operationId": "login_callback",
                "description": "",
                "parameters": [
                    {
                        "name": "code",
                        "in": "query",
                        "description": "Code from the OAuth provider",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "state",
                        "in": "query",
                        "description": "State from the OAuth provider",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": ""
                    },
                    "302": {
                        "description": "Redirect to the login page",
                        "type": "string"
                    }
                },
                "tags": [
                    "users"
                ]
            },
            "parameters": []
        },
        "/users/logout": {
            "post": {
                "operationId": "logout",
                "description": "Logout the user by invalidating the access token and removing the\ncredentials from the cookies.\n:param request: The request object\n:return: The response object",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "description": "Authorization",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "mock-session-user-id",
                        "in": "header",
                        "description": "Mock Session User Id",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Logout the user",
                        "type": "string"
                    }
                },
                "tags": [
                    "users"
                ]
            },
            "parameters": []
        },
        "/users/me": {
            "get": {
                "operationId": "users_me",
                "description": "",
                "parameters": [
                    {
                        "name": "Authorization",
                        "in": "header",
                        "description": "Authorization",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "mock-session-user-id",
                        "in": "header",
                        "description": "Mock Session User Id",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Current user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrentUserResponse"
                                }
                            }
                        }
                    }
                },
                "tags": [
                    "users"
                ]
            },
            "parameters": []
        }
    },
    "servers": [
        {
            "url": "http://localhost:8000"
        }
    ],
    "components": {
        "securitySchemes": {
            "Basic": {
                "type": "http",
                "scheme": "basic"
            }
        },
        "schemas": {
            "CreateListing": {
                "required": [
                    "title",
                    "description"
                ],
                "type": "object",
                "properties": {
                    "title": {
                        "title": "Title",
                        "type": "string",
                        "minLength": 1
                    },
                    "description": {
                        "title": "Description",
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "Coordinator": {
                "required": [
                    "id",
                    "email"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "title": "Id",
                        "type": "integer"
                    },
                    "email": {
                        "title": "Email",
                        "type": "string",
                        "format": "email",
                        "minLength": 1
                    }
                }
            },
            "Listing": {
                "required": [
                    "title",
                    "description",
                    "coordinators"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "title": "ID",
                        "type": "integer",
                        "readOnly": true
                    },
                    "title": {
                        "title": "Title",
                        "type": "string",
                        "maxLength": 255,
                        "minLength": 1
                    },
                    "description": {
                        "title": "Description",
                        "type": "string",
                        "minLength": 1
                    },
                    "updated_by": {
                        "title": "Updated by",
                        "type": "integer",
                        "readOnly": true
                    },
                    "updated_at": {
                        "title": "Updated at",
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "coordinators": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Coordinator"
                        }
                    }
                }
            },
            "ListingsListResponse": {
                "required": [
                    "listings",
                    "total_count"
                ],
                "type": "object",
                "properties": {
                    "listings": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Listing"
                        }
                    },
                    "total_count": {
                        "title": "Total count",
                        "type": "integer"
                    }
                }
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "title": "ID",
                        "type": "integer",
                        "readOnly": true
                    },
                    "email": {
                        "title": "Email",
                        "type": "string",
                        "format": "email",
                        "readOnly": true,
                        "minLength": 1
                    },
                    "username": {
                        "title": "Username",
                        "type": "string",
                        "readOnly": true,
                        "minLength": 1
                    },
                    "first_name": {
                        "title": "First name",
                        "type": "string",
                        "maxLength": 255,
                        "minLength": 1,
                        "nullable": true
                    },
                    "last_name": {
                        "title": "Last name",
                        "type": "string",
                        "maxLength": 255,
                        "minLength": 1,
                        "nullable": true
                    },
                    "is_superuser": {
                        "title": "Superuser status",
                        "description": "Designates that this user has all permissions without explicitly assigning them.",
                        "type": "boolean"
                    }
                }
            },
            "ListUsersResponse": {
                "required": [
                    "users",
                    "total_count"
                ],
                "type": "object",
                "properties": {
                    "users": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/User"
                        }
                    },
                    "total_count": {
                        "title": "Total count",
                        "type": "integer"
                    }
                }
            },
            "CurrentUserResponse": {
                "required": [
                    "user"
                ],
                "type": "object",
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/User"
                    }
                }
            }
        }
    }
}
